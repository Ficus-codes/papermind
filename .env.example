# ==========================================
# AI RESEARCH ASSISTANT - ENVIRONMENT CONFIG
# ==========================================

# Server Network & Runtime
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas connection string)
# Both MONGO_URI and MONGODB_URI are supported
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/papermind?retryWrites=true&w=majority

# Authentication Security (CRITICAL: Generate a strong, 64+ char random string for production)
# Example generation command: openssl rand -base64 48
JWT_SECRET=generate_a_cryptographically_secure_random_string_for_production

# CORS Security (Allowed origins comma-separated, or single CLIENT_URL)
# Examples: https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com
CLIENT_URL=https://your-frontend-domain.com

# LLM Providers (At least one provider or fallback heuristic is supported)
# Primary LLM (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Secondary LLM & Vector Embeddings (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq High-Speed Fallback (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Testing / Offline Development Flags
# Set to 'false' in production for real vector embeddings
MOCK_EMBEDDINGS=false
